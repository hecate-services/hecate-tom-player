%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_tom_player.
%%
%% TOM, Traders of Macao: the player's house. One purse, one ship, one page.

{erl_opts, [debug_info, warnings_as_errors]}.

%% hecate_om is the service substrate: the behaviour, the realm identity, the
%% mesh pool, /health, the container templates. It brings macula transitively,
%% but the house calls macula, macula_mri and macula_topic BY NAME, so macula is
%% named here too rather than inherited: a dependency you call is a dependency
%% you declare.
%%
%% cowboy is pinned to the same line hecate_om asks for. The house serves its own
%% listener on its own port, beside hecate_om's /health listener, and two
%% resolutions of the same application in one release is not a thing.
%%
%% JSON is OTP 28's own `json' module. There is no jsx here and there should not
%% be: the standard library grew the feature.
{deps, [
    {hecate_om, "~> 0.9"},
    {macula,    "~> 8.0"},
    {cowboy,    "~> 2.12.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% Elvis. The same focused structural ruleset the sibling TOM services run.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% macula and the reckon-db stack ship to hex WITHOUT debug_info (NIF-heavy
%% libraries), so dialyzer cannot read their Core Erlang and hard-fails on OTP
%% 28. Exclude them from the PLT and suppress the unknown-function notes that
%% necessarily follow; cowboy, ranch and this application's own modules are
%% still analysed, which is where the house's own mistakes would be.
{dialyzer, [
    {warnings, [no_unknown]},
    {exclude_apps, [
        macula, macula_envy, macula_mdns,
        reckon_db, reckon_evoq, reckon_gater, evoq,
        khepri, ra, horus, aten, seshat, gen_batch_server,
        gproc, msgpack, any, jsx
    ]}
]}.

{relx, [
    {release, {hecate_tom_player, "0.1.0"}, [hecate_tom_player, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

{shell, [{apps, [hecate_tom_player]}]}.
