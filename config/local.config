%% -*- mode: erlang -*-
%% A house you can run from the checkout, with `scripts/play.sh'.
%%
%% Everything here is what a second person on the other end of a mesh would need
%% to agree with you about: the realm name, the port names and the ship. The
%% realm TAG below is a throwaway for local play; a real game uses the one the
%% realm issued, and both ends must carry the same thirty-two bytes.
[
    {hecate_om, [
        {health_port, 8460},

        %% Thirty-two bytes as sixty-four hex characters. Local play only.
        {realm, <<"746f6d2d6c6f63616c2d7265616c6d2d666f722d6c6f63616c2d706c61792d21">>},

        %% The station this house dials out to. Empty means no mesh: the house
        %% still boots, still shows its page and still keeps its purse, and every
        %% call it makes comes back unreachable. That is a legitimate way to look
        %% at the page before a port exists.
        {station_seeds, []}
    ]},

    {hecate_tom_player, [
        {realm_name,         <<"io.macula">>},
        {player,             <<"raf">>},
        {ship,               <<"santa_clara">>},
        {harbours,           [<<"macao">>, <<"lisbon">>]},
        {goods,              [<<"pepper">>, <<"nutmeg">>, <<"raw_silk">>,
                              <<"porcelain">>]},
        {purse,              1000.0},
        {ledger,             "run/house.log"},
        {web_port,           8461},
        {quote_interval_ms,  5000},
        {locate_interval_ms, 10000}
    ]},

    {kernel, [{logger_level, notice}]}
].
